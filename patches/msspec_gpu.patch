+++ b/msspec_python3/src/msspec/spec/fortran/phd_mi_noso_nosp_nosym/phase_timer.f	2026-11-18 19:25:37.686707013 +0100
@@ -0,0 +1,73 @@
+C=======================================================================
+C  V2 phase timers (wall clock, SYSTEM_CLOCK). Used only for profiling.
+C  Phase ids: 1 matrix build, 2 solve (ZGETRF+ZGETRS), 3 angle loop
+C  (includes 4), 4 output writing, 5 TAU copy-out.
+C  V2PT_WRITE writes one line per phase (name seconds calls) to the file
+C  named by the environment variable MSSPEC_V2_PHASE_LOG. If the variable
+C  is unset or empty, nothing is written.
+C=======================================================================
+      SUBROUTINE V2PT_RESET()
+      IMPLICIT NONE
+      INTEGER*8 V2PT_T0(5), V2PT_TOT(5), V2PT_NC(5), V2PT_RATE
+      COMMON /V2PTCM/ V2PT_T0, V2PT_TOT, V2PT_NC, V2PT_RATE
+      INTEGER K
+      DO K=1,5
+        V2PT_T0(K)=0
+        V2PT_TOT(K)=0
+        V2PT_NC(K)=0
+      ENDDO
+      V2PT_RATE=0
+      RETURN
+      END
+
+      SUBROUTINE V2PT_START(K)
+      IMPLICIT NONE
+      INTEGER K
+      INTEGER*8 V2PT_T0(5), V2PT_TOT(5), V2PT_NC(5), V2PT_RATE
+      COMMON /V2PTCM/ V2PT_T0, V2PT_TOT, V2PT_NC, V2PT_RATE
+      INTEGER*8 CNT, RATE, CMAX
+      CALL SYSTEM_CLOCK(CNT, RATE, CMAX)
+      V2PT_RATE=RATE
+      V2PT_T0(K)=CNT
+      RETURN
+      END
+
+      SUBROUTINE V2PT_STOP(K)
+      IMPLICIT NONE
+      INTEGER K
+      INTEGER*8 V2PT_T0(5), V2PT_TOT(5), V2PT_NC(5), V2PT_RATE
+      COMMON /V2PTCM/ V2PT_T0, V2PT_TOT, V2PT_NC, V2PT_RATE
+      INTEGER*8 CNT, RATE, CMAX
+      CALL SYSTEM_CLOCK(CNT, RATE, CMAX)
+      V2PT_TOT(K)=V2PT_TOT(K)+(CNT-V2PT_T0(K))
+      V2PT_NC(K)=V2PT_NC(K)+1
+      RETURN
+      END
+
+      SUBROUTINE V2PT_WRITE()
+      IMPLICIT NONE
+      INTEGER*8 V2PT_T0(5), V2PT_TOT(5), V2PT_NC(5), V2PT_RATE
+      COMMON /V2PTCM/ V2PT_T0, V2PT_TOT, V2PT_NC, V2PT_RATE
+      CHARACTER*512 FNAME
+      CHARACTER*24 NAMES(5)
+      INTEGER FLEN, STAT, IU, K
+      DOUBLE PRECISION RATED
+      DATA NAMES /'fortran_matrix_build', 'fortran_solve',
+     &            'fortran_angle_loop', 'fortran_output_write',
+     &            'fortran_tau_copyout'/
+      FLEN=0
+      STAT=1
+      CALL GET_ENVIRONMENT_VARIABLE('MSSPEC_V2_PHASE_LOG', FNAME,
+     &                              FLEN, STAT)
+      IF((STAT.NE.0).OR.(FLEN.LE.0)) RETURN
+      RATED=DBLE(V2PT_RATE)
+      IF(RATED.LE.0.D0) RATED=1.D0
+      OPEN(NEWUNIT=IU, FILE=FNAME(1:FLEN), STATUS='REPLACE',
+     &     ACTION='WRITE')
+      DO K=1,5
+        WRITE(IU,'(A,1X,F0.9,1X,I0)') NAMES(K)(1:LEN_TRIM(NAMES(K))),
+     &    DBLE(V2PT_TOT(K))/RATED, V2PT_NC(K)
+      ENDDO
+      CLOSE(IU)
+      RETURN
+      END
