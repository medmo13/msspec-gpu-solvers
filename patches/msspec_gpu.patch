diff -ruN -x .git -x build -x __pycache__ -x '*.so' -x '*.o' -x '*.mod' -x output a/msspec_python3/src/msspec/spec/fortran/phd_mi_noso_nosp_nosym/v2_gpu_inv_mat.f b/msspec_python3/src/msspec/spec/fortran/phd_mi_noso_nosp_nosym/v2_gpu_inv_mat.f
--- a/msspec_python3/src/msspec/spec/fortran/phd_mi_noso_nosp_nosym/v2_gpu_inv_mat.f	1970-01-01 00:00:00.000000000 +0000
+++ b/msspec_python3/src/msspec/spec/fortran/phd_mi_noso_nosp_nosym/v2_gpu_inv_mat.f	2026-11-18 22:35:09.531485204 +0100
@@ -0,0 +1,373 @@
+C
+C=======================================================================
+C
+      SUBROUTINE V2_GPU_INV_MAT(JE,TAU,METH)
+C
+C   V2 GPU path (step 1b). Called from INV_MAT_MS when the environment
+C     variable MSSPEC_V2_GPU_METHOD is set and not empty. The CPU branch
+C     of INV_MAT_MS is not run in that case.
+C
+C   Host side (this routine), with the same formulas as the CPU branch of
+C     INV_MAT_MS: the row descriptors, the column descriptors, the pair
+C     functions YPAIR, HPAIR, ATTPAIR of each column atom, the Gaunt cache
+C     GNTC (as in the earlier GPU version, ped_assembly), and the reduced right-hand sides B (the
+C     absorber columns LF1..LF2 step ISTEP_LF). These are small per-pair
+C     arrays. The n x n matrix is NOT built here.
+C   GPU side (v2/src/solver/msspec_v2_gpu.cu): the matrix is assembled on
+C     the device in FP32, factored with cuSOLVER, and the solution X is
+C     returned in FP64. TAU is then copied out as in the IRHSRD=1 branch
+C     of INV_MAT_MS.
+C
+      USE DIM_MOD
+      USE COOR_MOD
+      USE INIT_L_MOD
+      USE TRANS_MOD
+C
+      IMPLICIT NONE
+C
+      INTEGER JE
+      COMPLEX TAU(LINMAX,LINFMAX,NATCLU_M)
+      CHARACTER*(*) METH
+C
+      COMPLEX*16 ONEC,IC,ZEROC,TLJ,TLK,EXPKJ
+      COMPLEX*16 YLM(0:2*NL_M,-2*NL_M:2*NL_M),HL1(0:2*NL_M)
+      REAL*8 GNT(0:N_GAUNT)
+      REAL*8 XKJ,YKJ,ZKJ,RKJ,ZDKJ,KRKJ
+      REAL XJ,YJ,ZJ
+      INTEGER IBESS,NL2,N,NRHS,NATOMS,V2MAXLK,V2GL,V2MAXL,JOFF
+      INTEGER NCOLJ,IFIRST,KCOL,KLIN
+      INTEGER LJ,MJ,LK,MK,L,M,ILJ,ILK,INDJ,INDK
+      INTEGER JTYP,JNUM,KTYP,KNUM,KATL,JATL,LMJ,LMK
+      INTEGER IGPUB,IBLEN,IBSTAT
+      CHARACTER*16 GBENV
+      COMPLEX*16, ALLOCATABLE :: SMH(:,:)
+C
+      INTEGER, ALLOCATABLE :: IROWA(:),IROWL(:),IROWM(:),IROWG(:)
+      INTEGER, ALLOCATABLE :: ICOLL(:),ICOLM(:),ICOLI(:)
+      COMPLEX*16, ALLOCATABLE :: ROWT(:),YPAIR(:,:,:),HPAIR(:,:)
+      COMPLEX*16, ALLOCATABLE :: B(:,:),X(:,:)
+      REAL*8, ALLOCATABLE :: GNTC(:,:,:),ATTP(:)
+C
+      ONEC=(1.D0,0.D0)
+      IC=(0.D0,1.D0)
+      ZEROC=(0.D0,0.D0)
+      IBESS=3
+      NL2=2*NL_M
+      NATOMS=NATCLU_M
+C
+C  Size of the matrix N = sum over atoms of (LMAX+1)^2
+C
+      N=0
+      DO JTYP=1,N_PROT
+        N=N+NATYP(JTYP)*(LMAX(JTYP,JE)+1)*(LMAX(JTYP,JE)+1)
+      ENDDO
+C
+C  Gaunt cache GNTC(0:V2GL,1:V2MAXL,1:V2MAXL), as in the earlier GPU version (ped_assembly)
+C    (row index INDK = LK*LK+LK+MK+1, column index INDJ = LJ*LJ+LJ+MJ+1)
+C
+      V2MAXLK=0
+      DO KTYP=1,N_PROT
+        V2MAXLK=MAX(V2MAXLK,LMAX(KTYP,JE))
+      ENDDO
+      V2GL=2*V2MAXLK
+      V2MAXL=(V2MAXLK+1)*(V2MAXLK+1)
+      ALLOCATE(GNTC(0:V2GL,V2MAXL,V2MAXL))
+      DO LK=0,V2MAXLK
+        DO MK=-LK,LK
+          INDK=LK*LK+LK+MK+1
+          DO LJ=0,V2MAXLK
+            DO MJ=-LJ,LJ
+              INDJ=LJ*LJ+LJ+MJ+1
+              GNT=0.D0
+              CALL GAUNT2(LK,MK,LJ,MJ,GNT)
+              GNTC(0:V2GL,INDJ,INDK)=GNT(0:V2GL)
+            ENDDO
+          ENDDO
+        ENDDO
+      ENDDO
+C
+C  Row descriptors, in the same order as the CPU branch (KLIN loop)
+C
+      ALLOCATE(IROWA(N),IROWL(N),IROWM(N),IROWG(N),ROWT(N))
+      N=0
+      DO KTYP=1,N_PROT
+        LMK=LMAX(KTYP,JE)
+        DO KNUM=1,NATYP(KTYP)
+          KATL=NCORR(KNUM,KTYP)
+          DO LK=0,LMK
+            ILK=LK*LK+LK+1
+            TLK=DCMPLX(TL(LK,1,KTYP,JE))
+            DO MK=-LK,LK
+              N=N+1
+              IROWA(N)=KATL
+              IROWL(N)=LK
+              IROWM(N)=MK
+              IROWG(N)=ILK+MK
+              ROWT(N)=TLK
+            ENDDO
+          ENDDO
+        ENDDO
+      ENDDO
+C
+C  Reduced right-hand sides: absorber columns LJ*LJ+LJ+1+MJ for the LF
+C    loop of phddif_mi.f (DO LF=LF1,LF2,ISTEP_LF), as in the IRHSRD=1 branch
+C
+      NRHS=0
+      DO LJ=0,LMAX(1,JE)
+        IF((LJ.GE.LF1).AND.(LJ.LE.LF2).AND.
+     1     (MOD(LJ-LF1,ISTEP_LF).EQ.0)) NRHS=NRHS+2*LJ+1
+      ENDDO
+      ALLOCATE(B(N,NRHS),X(N,NRHS))
+      B=ZEROC
+      KCOL=0
+      DO LJ=0,LMAX(1,JE)
+        IF((LJ.GE.LF1).AND.(LJ.LE.LF2).AND.
+     1     (MOD(LJ-LF1,ISTEP_LF).EQ.0)) THEN
+          DO MJ=-LJ,LJ
+            KCOL=KCOL+1
+            B(LJ*LJ+LJ+1+MJ,KCOL)=ONEC
+          ENDDO
+        ENDIF
+      ENDDO
+C
+C  Start the GPU matrix for this energy (descriptors and Gaunt cache)
+C
+      ALLOCATE(YPAIR(0:NL2,-NL2:NL2,NATOMS),HPAIR(0:NL2,NATOMS))
+      ALLOCATE(ATTP(NATOMS))
+      ALLOCATE(ICOLL(V2MAXL),ICOLM(V2MAXL),ICOLI(V2MAXL))
+      CALL MSSPEC_V2_GPU_BEGIN(METH,N,NATOMS,NL_M,V2GL,V2MAXL,GNTC,
+     1     IROWA,IROWL,IROWM,IROWG,ROWT)
+C
+C  Column atoms: pair functions (K relative to the column atom J) and
+C    the column block of J, in the same order as the CPU branch
+C
+C
+C  Matrix source (switch MSSPEC_V2_GPU_BUILD, read at each call; begin in
+C    msspec_v2_gpu.cu applies the same rule). '0' = CPU build, otherwise
+C    (unset, '1', ...) = GPU build by the column calls, as before.
+C
+      IGPUB=1
+      IBLEN=0
+      IBSTAT=1
+      GBENV=' '
+      CALL GET_ENVIRONMENT_VARIABLE('MSSPEC_V2_GPU_BUILD',GBENV,IBLEN,
+     1                              IBSTAT)
+      IF((IBSTAT.EQ.0).AND.(IBLEN.EQ.1)) THEN
+        IF(GBENV(1:1).EQ.'0') IGPUB=0
+      ENDIF
+C
+      IF(IGPUB.EQ.1) THEN
+      JOFF=0
+      DO JTYP=1,N_PROT
+        LMJ=LMAX(JTYP,JE)
+        DO JNUM=1,NATYP(JTYP)
+          JATL=NCORR(JNUM,JTYP)
+          XJ=SYM_AT(1,JATL)
+          YJ=SYM_AT(2,JATL)
+          ZJ=SYM_AT(3,JATL)
+          YPAIR=ZEROC
+          HPAIR=ZEROC
+          ATTP=0.D0
+          DO KTYP=1,N_PROT
+            LMK=LMAX(KTYP,JE)
+            DO KNUM=1,NATYP(KTYP)
+              KATL=NCORR(KNUM,KTYP)
+              IF(KATL.NE.JATL) THEN
+                XKJ=DBLE(SYM_AT(1,KATL)-XJ)
+                YKJ=DBLE(SYM_AT(2,KATL)-YJ)
+                ZKJ=DBLE(SYM_AT(3,KATL)-ZJ)
+                RKJ=DSQRT(XKJ*XKJ+YKJ*YKJ+ZKJ*ZKJ)
+                KRKJ=DBLE(VK(JE))*RKJ
+                ATTP(KATL)=DEXP(-DIMAG(DCMPLX(VK(JE)))*RKJ)
+                EXPKJ=(XKJ+IC*YKJ)/RKJ
+                ZDKJ=ZKJ/RKJ
+                CALL SPH_HAR2(NL2,ZDKJ,EXPKJ,YLM,LMJ+LMK)
+                CALL BESPHE2(LMJ+LMK+1,IBESS,KRKJ,HL1)
+                DO L=0,NL2
+                  DO M=-NL2,NL2
+                    YPAIR(L,M,KATL)=YLM(L,M)
+                  ENDDO
+                  HPAIR(L,KATL)=HL1(L)
+                ENDDO
+              ENDIF
+            ENDDO
+          ENDDO
+C
+C  Column descriptors of atom JATL: LJ, MJ, local index ILJ+MJ
+C
+          NCOLJ=0
+          DO LJ=0,LMJ
+            ILJ=LJ*LJ+LJ+1
+            DO MJ=-LJ,LJ
+              NCOLJ=NCOLJ+1
+              ICOLL(NCOLJ)=LJ
+              ICOLM(NCOLJ)=MJ
+              ICOLI(NCOLJ)=ILJ+MJ
+            ENDDO
+          ENDDO
+          IFIRST=JOFF+1
+          CALL MSSPEC_V2_GPU_COLUMN(IFIRST,NCOLJ,JATL,NATOMS,NL_M,
+     1         V2GL,V2MAXL,ICOLL,ICOLM,ICOLI,YPAIR,HPAIR,ATTP)
+          JOFF=JOFF+NCOLJ
+        ENDDO
+      ENDDO
+      ELSE
+C
+C  CPU build (MSSPEC_V2_GPU_BUILD=0): MS in FP64 by the stock loop
+C    (V2_HOST_MS), then one upload to the device (msspec_v2_gpu.cu)
+C
+        ALLOCATE(SMH(N,N))
+        CALL V2_HOST_MS(JE,N,SMH)
+        CALL MSSPEC_V2_GPU_UPLOAD(N,SMH)
+        DEALLOCATE(SMH)
+      ENDIF
+C
+C  Solve MS * X = B on the GPU (X is FP64)
+C
+      CALL MSSPEC_V2_GPU_SOLVE(N,NRHS,B,X)
+C
+C   Storage of the Tau matrix: copy of the IRHSRD=1 branch of
+C     INV_MAT_MS, with X in place of IN
+C
+      KCOL=0
+      DO LJ=0,LMAX(1,JE)
+        ILJ=LJ*LJ+LJ+1
+        TLJ=DCMPLX(TL(LJ,1,1,JE))
+        IF((LJ.GE.LF1).AND.(LJ.LE.LF2).AND.
+     1     (MOD(LJ-LF1,ISTEP_LF).EQ.0)) THEN
+          DO MJ=-LJ,LJ
+            INDJ=ILJ+MJ
+            KCOL=KCOL+1
+            KLIN=0
+            DO KTYP=1,N_PROT
+              LMK=LMAX(KTYP,JE)
+              DO KNUM=1,NATYP(KTYP)
+                KATL=NCORR(KNUM,KTYP)
+                DO LK=0,LMK
+                  ILK=LK*LK+LK+1
+                  DO MK=-LK,LK
+                    INDK=ILK+MK
+                    KLIN=KLIN+1
+                    TAU(INDK,INDJ,KATL)=CMPLX(X(KLIN,KCOL)*TLJ)
+                  ENDDO
+                ENDDO
+              ENDDO
+            ENDDO
+          ENDDO
+        ENDIF
+      ENDDO
+C
+      DEALLOCATE(IROWA,IROWL,IROWM,IROWG,ROWT,B,X,GNTC,ATTP)
+      DEALLOCATE(YPAIR,HPAIR,ICOLL,ICOLM,ICOLI)
+      RETURN
+      END
+C
+C=======================================================================
+C
+      SUBROUTINE V2_HOST_MS(JE,N,SMH)
+C
+C   CPU build of the V2 matrix MS = (I-GoT) for MSSPEC_V2_GPU_BUILD=0.
+C     The loops are the JLIN/KLIN build loops of INV_MAT_MS
+C     (axb_mat_ms_la.f), in FP64 with the same formulas, so SMH(KLIN,JLIN)
+C     holds the same elements as the stock matrix SM. N must equal the
+C     number of columns JLIN counted here.
+C
+      USE DIM_MOD
+      USE COOR_MOD
+      USE INIT_L_MOD
+      USE TRANS_MOD
+C
+      IMPLICIT NONE
+C
+      INTEGER JE,N
+      COMPLEX*16 SMH(N,N)
+      COMPLEX*16 HL1(0:2*NL_M),SUM_L,ONEC,IC,ZEROC
+      COMPLEX*16 YLM(0:2*NL_M,-2*NL_M:2*NL_M),TLJ,TLK,EXPKJ
+      REAL*8 PI,ATTKJ,GNT(0:N_GAUNT),XKJ,YKJ,ZKJ,RKJ,ZDKJ,KRKJ
+      REAL XJ,YJ,ZJ
+      INTEGER IBESS,JLIN,KLIN,JTYP,JNUM,JATL,LMJ,LJ,ILJ,MJ
+      INTEGER KTYP,KNUM,KATL,LMK,LK,ILK,MK,L_MIN,L_MAX,L,M
+      INTEGER NBTYPJ,NBTYPK
+C
+      DATA PI /3.1415926535898D0/
+C
+      ONEC=(1.D0,0.D0)
+      IC=(0.D0,1.D0)
+      ZEROC=(0.D0,0.D0)
+      IBESS=3
+      JLIN=0
+      DO JTYP=1,N_PROT
+        NBTYPJ=NATYP(JTYP)
+        LMJ=LMAX(JTYP,JE)
+        DO JNUM=1,NBTYPJ
+          JATL=NCORR(JNUM,JTYP)
+          XJ=SYM_AT(1,JATL)
+          YJ=SYM_AT(2,JATL)
+          ZJ=SYM_AT(3,JATL)
+          DO LJ=0,LMJ
+            ILJ=LJ*LJ+LJ+1
+            TLJ=DCMPLX(TL(LJ,1,JTYP,JE))
+            DO MJ=-LJ,LJ
+              JLIN=JLIN+1
+              KLIN=0
+              DO KTYP=1,N_PROT
+                NBTYPK=NATYP(KTYP)
+                LMK=LMAX(KTYP,JE)
+                DO KNUM=1,NBTYPK
+                  KATL=NCORR(KNUM,KTYP)
+                  IF(KATL.NE.JATL) THEN
+                    XKJ=DBLE(SYM_AT(1,KATL)-XJ)
+                    YKJ=DBLE(SYM_AT(2,KATL)-YJ)
+                    ZKJ=DBLE(SYM_AT(3,KATL)-ZJ)
+                    RKJ=DSQRT(XKJ*XKJ+YKJ*YKJ+ZKJ*ZKJ)
+                    KRKJ=DBLE(VK(JE))*RKJ
+                    ATTKJ=DEXP(-DIMAG(DCMPLX(VK(JE)))*RKJ)
+                    EXPKJ=(XKJ+IC*YKJ)/RKJ
+                    ZDKJ=ZKJ/RKJ
+                    CALL SPH_HAR2(2*NL_M,ZDKJ,EXPKJ,YLM,LMJ+LMK)
+                    CALL BESPHE2(LMJ+LMK+1,IBESS,KRKJ,HL1)
+                  ENDIF
+C
+                  DO LK=0,LMK
+                    ILK=LK*LK+LK+1
+                    L_MIN=ABS(LK-LJ)
+                    L_MAX=LK+LJ
+                    TLK=DCMPLX(TL(LK,1,KTYP,JE))
+                    DO MK=-LK,LK
+                      KLIN=KLIN+1
+                      SUM_L=ZEROC
+                      IF(KATL.NE.JATL) THEN
+                        CALL GAUNT2(LK,MK,LJ,MJ,GNT)
+                        DO L=L_MIN,L_MAX,2
+                          M=MJ-MK
+                          IF(ABS(M).LE.L) THEN
+                            SUM_L=SUM_L+(IC**L)*HL1(L)*
+     1                                   YLM(L,M)*GNT(L)
+                          ENDIF
+                        ENDDO
+                        SUM_L=SUM_L*ATTKJ*4.D0*PI*IC
+                      ENDIF
+C
+                      IF(KLIN.EQ.JLIN) THEN
+                        SMH(KLIN,JLIN)=ONEC-TLK*SUM_L
+                      ELSE
+                        SMH(KLIN,JLIN)=-TLK*SUM_L
+                      ENDIF
+                    ENDDO
+                  ENDDO
+C
+                ENDDO
+              ENDDO
+C
+            ENDDO
+          ENDDO
+C
+        ENDDO
+      ENDDO
+C
